{
  "name": "cplayout",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=20.19.4 <25",
    "npm": ">=10 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node tools/patch_xcode_uuid_dependency.cjs",
    "start": "npm run start -w @cplayout/mobile",
    "web": "npm run web -w @cplayout/mobile",
    "android": "npm run android -w @cplayout/mobile",
    "export:web": "npm run export:web -w @cplayout/mobile",
    "ui:test:start": "tsx tools/devServerManager.ts start",
    "ui:test:status": "tsx tools/devServerManager.ts status",
    "ui:test:stop": "tsx tools/devServerManager.ts stop",
    "dev:web:smart": "tsx tools/devServerManager.ts dev-web-smart",
    "test:web:e2e": "playwright test --config playwright.config.ts",
    "proof:web": "npm run export:web && npm run test:web:e2e",
    "reference-overlays:build": "tsx tools/build_reference_overlays.ts",
    "ml-cv-loop:run": "PYTHONPATH=tools/local-ml-companion/src python3 -m cplayout_ml.cli run-pivot-locator-loop --synthetic-fixture --output-dir reports/ml-cv-pivot-locating/20260601T-run --iterations 100 --created-at 2026-06-01T00:00:00.000Z",
    "ml-cv-pivot-candidates:run": "PYTHONPATH=tools/local-ml-companion/src python3 -m cplayout_ml.cli detect-pivot-candidates --synthetic-fixture --project-id synthetic-pivot-candidate --project-crs LOCAL:IMAGE --output-dir reports/ml-cv-pivot-candidates/20260601T-run --iterations 100 --created-at 2026-06-01T00:00:00.000Z",
    "review:will-rhea-visual": "tsx tools/willRheaVisualReview.ts",
    "real-pivot-fixture:generate": "tsx tools/generateRealPivotFixtureManifest.ts",
    "test:ml-companion": "PYTHONPATH=tools/local-ml-companion/src python3 -m unittest discover -s tools/local-ml-companion/tests",
    "verify:native-maplibre": "tsx tools/nativeMapLibreProof.ts",
    "review:android-app": "tsx tools/androidAppReview.ts",
    "typecheck": "tsc -p tsconfig.tools.json && npm run typecheck --workspaces --if-present",
    "test": "tsx tools/referenceOverlayBuilder.test.ts && tsx tools/pngMetrics.test.ts && tsx tools/androidResources.test.ts && tsx tools/androidFileUiEvidence.test.ts && tsx tools/devServerManager.test.ts && tsx tools/prepareMapLibreAssets.test.ts && tsx tools/metroDependency.test.ts && tsx tools/windowsLauncherScripts.test.ts && tsx tools/generateRealPivotFixtureManifest.test.ts && tsx tools/generateClientKmzAdvisoryReport.test.ts && tsx tools/verifyImageryEvidencePacket.test.ts && tsx tools/roadmapCompletion.test.ts && tsx tools/androidAppReview.test.ts && tsx tools/cornerGpsFltInventory.test.ts && npm run test --workspaces --if-present",
    "context-map:build": "python3 tools/build_cplayout_context_map.py --write",
    "context-map:check": "python3 tools/build_cplayout_context_map.py --check",
    "validate:corner-service-manuals": "python3 tools/validate_corner_service_manuals.py",
    "validate:design-guides": "python3 tools/validate_design_guides.py",
    "validate:skills": "python3 tools/validate_cplayout_skills.py",
    "validate": "npm run typecheck && npm test",
    "audit:moderate": "npm audit --audit-level=moderate",
    "check:android-tools": "tsx tools/check_android_tools.ts",
    "verify:android-layout": "tsx tools/androidLayoutProof.ts",
    "verify:android-native": "tsx tools/verify_android_native.ts",
    "verify:imagery-evidence": "tsx tools/verifyImageryEvidencePacket.ts",
    "verify:loop-ledger": "tsx tools/verify_continuous_improvement_ledger.ts",
    "verify:ml-cv-loop": "tsx tools/verify_research_improvement_loop.ts --path docs/ml-cv-pivot-locating-improvement-loop.md --through 100",
    "verify:whole-loop": "tsx tools/verify_whole_codebase_improvement_loop.ts --path docs/whole-codebase-improvement-loop-2026-06-01.md --through 100",
    "verify:roadmap": "tsx tools/roadmapCompletion.ts --full",
    "verify:roadmap:fast": "tsx tools/roadmapCompletion.ts --fast",
    "verify:release": "tsx tools/roadmapCompletion.ts --release"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.13.3",
    "tsx": "4.22.4",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
