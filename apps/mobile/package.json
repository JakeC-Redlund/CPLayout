{
  "name": "@cplayout/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "prestart": "tsx ../../tools/prepareMapLibreAssets.ts",
    "start": "expo start --host localhost",
    "preweb": "tsx ../../tools/prepareMapLibreAssets.ts",
    "web": "expo start --web --host localhost",
    "android": "expo run:android",
    "preexport:web": "tsx ../../tools/prepareMapLibreAssets.ts",
    "export:web": "expo export --platform web --clear",
    "test": "tsx src/advisory/advisoryJob.test.ts && tsx src/navigation/navigationViewModels.test.ts && tsx src/navigation/projectTreeViewModel.test.ts && tsx src/gnss/webSerialTransport.test.ts && tsx src/gnss/webSerialTransportSafety.test.ts && tsx src/gnss/webSerialSessionOwner.test.ts && tsx src/gnss/captureDraft.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck"
  },
  "dependencies": {
    "@cplayout/core": "*",
    "@cplayout/geometry": "*",
    "@cplayout/gnss": "*",
    "@cplayout/map-adapters": "*",
    "@cplayout/project-store": "*",
    "@expo/metro-runtime": "~55.0.12",
    "@maplibre/maplibre-react-native": "^11.2.1",
    "expo": "~55.0.28",
    "expo-dev-client": "~55.0.37",
    "expo-file-system": "~55.0.24",
    "expo-sharing": "~55.0.22",
    "expo-splash-screen": "~55.0.23",
    "expo-sqlite": "~55.0.18",
    "expo-status-bar": "55.0.6",
    "lucide-react-native": "1.16.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@types/react": "19.2.16",
    "typescript": "~5.9.2"
  }
}
