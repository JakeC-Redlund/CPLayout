+int NativeDatabaseBinding::sqlite3_open_existing_only(const std::string &dbPath) {
+  if (db != nullptr) {
+    return SQLITE_MISUSE;
+  }
+  sqlite3 *opened = nullptr;
+  constexpr int flags = SQLITE_OPEN_READWRITE | SQLITE_OPEN_FULLMUTEX |
+                        SQLITE_OPEN_PRIVATECACHE | SQLITE_OPEN_NOFOLLOW;
+  int result = ::exsqlite3_open_v2(dbPath.c_str(), &opened, flags, nullptr);
+  if (result == SQLITE_OK && ::exsqlite3_db_readonly(opened, "main") != 0) {
+    result = SQLITE_READONLY;
+  }
+  if (result == SQLITE_OK &&
+      (::exsqlite3_threadsafe() == 0 || ::exsqlite3_db_mutex(opened) == nullptr)) {
+    result = SQLITE_MISUSE;
+  }
+  if (result != SQLITE_OK) {
+    // Failed opens can still allocate a handle; no statements have escaped.
+    const int closeResult = ::exsqlite3_close_v2(opened);
+    if (closeResult != SQLITE_OK) {
+      db = opened;
+      jni::throwNewJavaException(SQLiteErrorException::create(
+          "Existing-only open failed (" + std::to_string(result) +
+          "); cleanup failed (" + std::to_string(closeResult) + ")").get());
+    }
+    return result;
+  }
+  db = opened;
+  return SQLITE_OK;
+}
+
+int NativeDatabaseBinding::sqlite3_check_main_not_moved() {
+  if (db == nullptr) {
+    return SQLITE_MISUSE;
+  }
+  int moved = -1;
+  const int result = ::exsqlite3_file_control(db, "main", SQLITE_FCNTL_HAS_MOVED, &moved);
+  if (result != SQLITE_OK) {
+    return result;
+  }
+  return moved == 0 ? SQLITE_OK : SQLITE_IOERR;
+}
+
+int NativeDatabaseBinding::sqlite3_install_ownership_guard() {
+  if (db == nullptr) return SQLITE_MISUSE;
+  const int disabled = ::exsqlite3_enable_load_extension(db, 0);
+  if (disabled != SQLITE_OK) return disabled;
+  return ::exsqlite3_set_authorizer(db, ownershipAuthorizer, nullptr);
+}
