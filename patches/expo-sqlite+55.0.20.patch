+package expo.modules.sqlite;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Process-local handle ownership bookkeeping, based solely on caller-supplied snapshots.
+ * This class performs no filesystem probes and supplies no physical ownership proof.
+ */
+public final class CPLayoutConnectionRegistry {
+  /** Survives module/JS refresh within this class loader, not OS process replacement. */
+  public static final CPLayoutConnectionRegistry PROCESS = new CPLayoutConnectionRegistry(256);
+
+  public static final class FileIdentity {
+    public final long device;
+    public final long inode;
+
+    public FileIdentity(long device, long inode) {
+      this.device = device;
+      this.inode = inode;
+    }
+
+    @Override
+    public boolean equals(Object other) {
+      if (this == other) {
+        return true;
+      }
+      if (!(other instanceof FileIdentity)) {
+        return false;
+      }
+      FileIdentity identity = (FileIdentity) other;
+      return device == identity.device && inode == identity.inode;
+    }
+
+    @Override
+    public int hashCode() {
+      return 31 * Long.hashCode(device) + Long.hashCode(inode);
+    }
+  }
+
+  private enum State {
+    OPENING, OPEN, CLOSING, POISONED, RELEASED
+  }
+
+  public static final class Ticket {
+    private final CPLayoutConnectionRegistry owner;
+    private final String path;
+    private final FileIdentity beforeIdentity;
+    private FileIdentity observedIdentity;
+    private final boolean exclusive;
+    private final boolean transientHandle;
+    private State state = State.OPENING;
+    private boolean openCompletionAttempted;
+
+    private Ticket(CPLayoutConnectionRegistry owner, String path,
+        FileIdentity beforeIdentity, boolean exclusive, boolean transientHandle) {
+      this.owner = owner;
+      this.path = path;
+      this.beforeIdentity = beforeIdentity;
+      this.exclusive = exclusive;
+      this.transientHandle = transientHandle;
+    }
+  }
+
+  private final int maxTickets;
+  private final List<Ticket> tickets = new ArrayList<Ticket>();
+
+  public CPLayoutConnectionRegistry(int maxTickets) {
+    if (maxTickets <= 0) {
+      throw new IllegalArgumentException("maxTickets must be positive");
+    }
+    this.maxTickets = maxTickets;
+  }
+
+  public synchronized Ticket beginOpen(String canonicalASCIIPath,
+      FileIdentity beforeNullable, boolean exclusive) {
+    validatePath(canonicalASCIIPath, exclusive);
+    if (exclusive && beforeNullable == null) {
+      throw new IllegalArgumentException("Exclusive opens require a before identity");
+    }
+    if (tickets.size() >= maxTickets) {
+      throw new IllegalStateException("Connection ticket capacity reached");
+    }
+    // A previously exposed connection may already have attached another database.
+    if (exclusive && !tickets.isEmpty()) {
+      throw new IllegalStateException("Exclusive open requires an empty registry");
+    }
+    for (Ticket existing : tickets) {
+      if ((exclusive || existing.exclusive)
+          && conflicts(existing, canonicalASCIIPath, beforeNullable)) {
+        throw new IllegalStateException("Connection ownership conflict");
+      }
+      if (!exclusive && beforeNullable == null && existing.exclusive) {
+        throw new IllegalStateException("Unknown identity while an exclusive ticket is held");
+      }
+    }
+    Ticket ticket = new Ticket(this, canonicalASCIIPath, beforeNullable, exclusive, false);
+    tickets.add(ticket);
+    return ticket;
+  }
+
+  /** Tracks memory/deserialized handles without inventing a filesystem identity. */
+  public synchronized Ticket beginTransientOpen() {
+    if (tickets.size() >= maxTickets) {
+      throw new IllegalStateException("Connection ticket capacity reached");
+    }
+    for (Ticket existing : tickets) {
+      if (existing.exclusive) {
+        throw new IllegalStateException("Transient open while an exclusive ticket is held");
+      }
+    }
+    Ticket ticket = new Ticket(this, null, null, false, true);
+    tickets.add(ticket);
+    return ticket;
+  }
+
+  public synchronized void transientOpened(Ticket ticket) {
+    requireState(ticket, State.OPENING);
+    if (!ticket.transientHandle) {
+      throw new IllegalStateException("File tickets require an observed filesystem identity");
+    }
+    ticket.openCompletionAttempted = true;
+    ticket.state = State.OPEN;
+  }
+
+  public synchronized void opened(Ticket ticket, FileIdentity observedNonNull) {
+    requireState(ticket, State.OPENING);
+    if (ticket.transientHandle) {
+      throw new IllegalStateException("Transient tickets cannot receive a filesystem identity");
+    }
+    if (ticket.openCompletionAttempted) {
+      throw new IllegalStateException("Open completion has already been attempted");
+    }
+    // Keep the observed alias even when validation fails, until cleanup is confirmed.
+    ticket.openCompletionAttempted = true;
+    ticket.observedIdentity = observedNonNull;
+    if (observedNonNull == null) {
+      throw new IllegalArgumentException("Opened handles require an observed identity");
+    }
+    if (ticket.beforeIdentity != null && !ticket.beforeIdentity.equals(observedNonNull)) {
+      throw new IllegalStateException("File identity changed during open");
+    }
+    for (Ticket existing : tickets) {
+      if (existing != ticket && (ticket.exclusive || existing.exclusive)
+          && conflicts(existing, ticket.path, observedNonNull)) {
+        throw new IllegalStateException("Observed identity conflicts with exclusive ownership");
+      }
+    }
+    ticket.state = State.OPEN;
+  }
+
+  public synchronized void openFailed(Ticket ticket, boolean cleanupConfirmed) {
+    requireState(ticket, State.OPENING);
+    finish(ticket, cleanupConfirmed);
+  }
+
+  public synchronized void beginClose(Ticket ticket) {
+    requireState(ticket, State.OPEN);
+    ticket.state = State.CLOSING;
+  }
+
+  public synchronized void closeCompleted(Ticket ticket, boolean closed) {
+    requireState(ticket, State.CLOSING);
+    finish(ticket, closed);
+  }
+
+  public synchronized void assertExclusive(Ticket ticket, FileIdentity current) {
+    requireState(ticket, State.OPEN);
+    if (!ticket.exclusive) {
+      throw new IllegalStateException("Ticket is not exclusive");
+    }
+    if (current == null || !ticket.beforeIdentity.equals(ticket.observedIdentity)
+        || !ticket.observedIdentity.equals(current)) {
+      throw new IllegalStateException("Exclusive identity assertion failed");
+    }
+  }
+
+  public synchronized int liveCount() {
+    return tickets.size();
+  }
+
+  /** The caller must hold this registry's monitor across this check and its filesystem operation. */
+  public synchronized void assertUnowned(String canonicalPath, FileIdentity identityNullable) {
+    validatePath(canonicalPath, false);
+    for (Ticket ticket : tickets) {
+      if (ticket.transientHandle || conflicts(ticket, canonicalPath, identityNullable)
+          || (identityNullable == null && ticket.exclusive)) {
+        throw new IllegalStateException("A live connection ticket prevents the filesystem operation");
+      }
+    }
+  }
+
+  private void requireState(Ticket ticket, State required) {
+    if (ticket == null || ticket.owner != this) {
+      throw new IllegalArgumentException("Ticket does not belong to this registry");
+    }
+    if (ticket.state != required || !tickets.contains(ticket)) {
+      throw new IllegalStateException("Ticket is not in the required state: " + required);
+    }
+  }
+
+  private void finish(Ticket ticket, boolean cleanupConfirmed) {
+    if (cleanupConfirmed) {
+      tickets.remove(ticket);
+      ticket.state = State.RELEASED;
+    } else {
+      ticket.state = State.POISONED;
+    }
+  }
+
+  private static boolean conflicts(Ticket ticket, String path, FileIdentity identity) {
+    // Compare exact database/sidecar names in both directions, never broad prefixes.
+    return (ticket.path != null && (path.equals(ticket.path)
+        || isSidecar(ticket.path, path) || isSidecar(path, ticket.path))) || (identity != null
+        && (identity.equals(ticket.beforeIdentity) || identity.equals(ticket.observedIdentity)));
+  }
+
+  private static boolean isSidecar(String databasePath, String candidatePath) {
+    return candidatePath.equals(databasePath + "-wal")
+        || candidatePath.equals(databasePath + "-shm")
+        || candidatePath.equals(databasePath + "-journal");
+  }
+
+  private static void validatePath(String path, boolean strictASCII) {
+    if (path == null || path.length() < 2 || path.length() > 4096 || path.charAt(0) != '/') {
+      throw new IllegalArgumentException("An absolute canonical file path of at most 4096 characters is required");
+    }
+    int segmentStart = 1;
+    for (int i = 1; i <= path.length(); i++) {
+      if (i == path.length() || path.charAt(i) == '/') {
+        int length = i - segmentStart;
+        if (length == 0 || (length == 1 && path.charAt(segmentStart) == '.')
+            || (length == 2 && path.charAt(segmentStart) == '.'
+                && path.charAt(segmentStart + 1) == '.')) {
+          throw new IllegalArgumentException("Empty or relative path segments are forbidden");
+        }
+        segmentStart = i + 1;
+      } else {
+        char c = path.charAt(i);
+        if (c == 0 || (strictASCII && !((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')
+            || (c >= '0' && c <= '9') || c == '_' || c == '.' || c == '-'))) {
+          throw new IllegalArgumentException("Path contains a forbidden character");
+        }
+      }
+    }
+  }
+}
