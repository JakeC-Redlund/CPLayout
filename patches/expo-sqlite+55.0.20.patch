+  }
+
+  fun <T> withOwnershipLock(operation: () -> T): T = synchronized(registry) { operation() }
+
+  fun copyUnowned(source: File, destination: File, overwrite: Boolean) = synchronized(registry) {
+    val sourcePath = source.canonicalPath
+    registry.assertUnowned(sourcePath, cplayoutProbe(sourcePath))
+    registry.assertUnowned(destination.path, cplayoutProbe(destination.path))
+    source.copyTo(destination, overwrite)
+  }
+
+  fun mutateUnowned(path: String, mutation: () -> Unit) = synchronized(registry) {
+    registry.assertUnowned(path, cplayoutProbe(path))
+    mutation()
+  }
+}
