+package expo.modules.sqlite;
+
+/** Validates caller-supplied metadata only; the Android adapter owns lstat. */
+public final class CPLayoutSidecarPolicy {
+  private CPLayoutSidecarPolicy() {}
+
+  public static void requireSafe(boolean regularFile, long linkCount, int ownerUid, int appUid) {
+    if (!regularFile || linkCount != 1L || ownerUid != appUid) {
+      throw new IllegalStateException("Source sidecar must be regular, singly linked and app-owned");
+    }
+  }
+}
