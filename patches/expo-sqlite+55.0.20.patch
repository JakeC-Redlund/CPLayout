+package expo.modules.sqlite
+
+import android.os.Process
+import android.system.ErrnoException
+import android.system.Os
+import android.system.OsConstants
+import android.system.StructStat
+import java.io.File
+import java.io.FileDescriptor
+import java.io.IOException
+import java.util.Collections
+
+internal fun cplayoutIdentity(stat: StructStat) = CPLayoutConnectionRegistry.FileIdentity(stat.st_dev, stat.st_ino)
+
+internal fun cplayoutProbe(path: String): CPLayoutConnectionRegistry.FileIdentity? {
+  val stat = try { Os.lstat(path) } catch (error: ErrnoException) {
+    if (error.errno == OsConstants.ENOENT) return null
+    throw error
+  }
+  if (!OsConstants.S_ISREG(stat.st_mode)) throw IOException("Database path is not a regular file")
+  return cplayoutIdentity(stat)
+}
+
+internal class CPLayoutSourceDescriptor private constructor(
+  val path: String,
+  private val fd: FileDescriptor,
+  private val initial: StructStat,
+  private val directory: File,
+  private val initialDirectory: StructStat
+) {
+  private var closeAttempted = false
+
+  fun verify(): CPLayoutConnectionRegistry.FileIdentity {
+    if (closeAttempted) throw IOException("Source descriptor is no longer available")
+    verifyDirectory(directory, initialDirectory)
+    verifySidecars(path)
+    val descriptorStat = Os.fstat(fd)
+    val pathStat = Os.lstat(path)
+    for (stat in listOf(descriptorStat, pathStat)) {
+      if (!OsConstants.S_ISREG(stat.st_mode) || stat.st_nlink != 1L || stat.st_uid != Process.myUid() ||
+        stat.st_mode != initial.st_mode || cplayoutIdentity(stat) != cplayoutIdentity(initial)) {
+        throw IOException("Source identity or ownership changed")
+      }
+    }
+    if (File(path).canonicalPath != path) throw IOException("Source path changed")
+    return cplayoutIdentity(initial)
+  }
+
+  fun close() {
+    if (closeAttempted) throw IOException("Source descriptor close already attempted")
+    closeAttempted = true
+    Os.close(fd)
+  }
+
+  companion object {
+    private fun verifySidecars(path: String) {
+      for (suffix in listOf("-wal", "-shm", "-journal")) {
+        val stat = try { Os.lstat(path + suffix) } catch (error: ErrnoException) {
+          if (error.errno == OsConstants.ENOENT) continue
+          throw error
+        }
+        CPLayoutSidecarPolicy.requireSafe(OsConstants.S_ISREG(stat.st_mode), stat.st_nlink, stat.st_uid, Process.myUid())
+      }
+    }
+
+    private fun verifyDirectory(directory: File, expected: StructStat) {
+      val current = Os.lstat(directory.path)
+      if (!OsConstants.S_ISDIR(current.st_mode) || current.st_uid != Process.myUid() ||
+        current.st_mode != expected.st_mode || cplayoutIdentity(current) != cplayoutIdentity(expected) ||
+        directory.canonicalPath != directory.path) throw IOException("Source directory identity or ownership changed")
+    }
+
+    fun open(path: String, expected: CPLayoutConnectionRegistry.FileIdentity, sourceDirectory: File): CPLayoutSourceDescriptor {
+      val directoryStat = Os.lstat(sourceDirectory.path)
+      verifyDirectory(sourceDirectory, directoryStat)
+      if (File(path).parentFile?.path != sourceDirectory.path || File(path).canonicalPath != path) {
+        throw IOException("Source must be in the app-private SQLite directory")
+      }
+      val before = Os.lstat(path)
+      if (!OsConstants.S_ISREG(before.st_mode) || before.st_nlink != 1L || before.st_uid != Process.myUid() ||
+        cplayoutIdentity(before) != expected) throw IOException("Source is not exclusively linked and app-owned")
+      verifySidecars(path)
+      val fd = Os.open(path, OsConstants.O_RDONLY or OsConstants.O_NOFOLLOW or OsConstants.O_CLOEXEC, 0)
+      val descriptor = CPLayoutSourceDescriptor(path, fd, before, sourceDirectory, directoryStat)
+      // The caller must retain this object before validation so failed close is quarantined.
+      return descriptor
+    }
+  }
